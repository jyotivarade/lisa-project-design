# LISA backend configuration. Copy to .env and adjust.
# Nothing here is a business value — tolerances, adjustments and thresholds live in
# the database per Analytics (docs/05-CONFIGURATION.md).

LISA_ENVIRONMENT=development
LISA_DEBUG=true
LISA_LOG_LEVEL=INFO
LISA_LOG_JSON=false

# psycopg (v3) driver is required.
LISA_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lisa

# MUST be overridden outside development.
LISA_SECRET_KEY=dev-only-insecure-key-change-me-0123456789
LISA_ACCESS_TOKEN_TTL_SECONDS=900
LISA_REFRESH_TOKEN_TTL_SECONDS=604800

# Unset: derived from LISA_ENVIRONMENT (off for development/test, on otherwise).
# A Secure cookie is not sent over plain HTTP, so leave this unset locally.
# LISA_REFRESH_COOKIE_SECURE=true

LISA_CORS_ORIGINS=["http://localhost:5173"]

LISA_STORAGE_BACKEND=local
LISA_STORAGE_LOCAL_ROOT=./var/storage
LISA_MAX_UPLOAD_BYTES=104857600
