# The frontend ships no business configuration. Thresholds, tolerances and
# calibrator/control identities are fetched from the API at runtime (spec section 43).
VITE_API_BASE=/api

# Development convenience only: adds an "Autofill" button to the login form.
# Vite strips the block from production builds, and `.env` is never committed.
# Leave unset to render no button.
VITE_DEV_LOGIN_EMAIL=admin@lisa.local
VITE_DEV_LOGIN_PASSWORD=
